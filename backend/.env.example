# Copy this file to .env and fill in real values.
# Variable names are case-sensitive — they must match exactly what
# src/server.ts reads (process.env.DATABASE_PUBLIC_URL, process.env.PORT,
# process.env.JWT_SECRET).

DATABASE_PUBLIC_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/internet_ojt
PORT=5000

# Signs every login token. Must be at least 32 random characters; the
# server refuses to start while this placeholder is still in place.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Set to "production" on the hosting platform. It hides raw database errors
# from users, disables /api/test-db, restricts CORS to FRONTEND_URL, and
# trusts the platform's reverse proxy for rate limiting.
# NODE_ENV=production

# Public application URL used for password recovery links and, in
# production, the only browser origin allowed to call the API.
# Production URLs must use HTTPS.
FRONTEND_URL=http://localhost:5173

# Optional extra allowed browser origins in production, comma-separated
# (for example a custom domain in addition to the Vercel URL).
# CORS_ORIGINS=

# The server always runs on Philippine time (Asia/Manila). It sets this
# itself at start-up, so a TZ value here or on the host has no effect.

# Failed logins allowed per account before a 15-minute lockout (default 5).
# LOGIN_MAX_FAILURES=5

# Failed logins allowed from one network address, across all accounts, per
# 15 minutes (default 100). Keep it high if many users share one campus
# connection.
# LOGIN_IP_MAX_FAILURES=100

# How old a break, back-to-work or time-out recorded offline may be when the
# phone sends it, in hours (1 to 72, default 12). Older ones are refused and
# the student is pointed to the missed time-out form.
# OFFLINE_ACTION_MAX_AGE_HOURS=12

# Privacy. Both are off when unset.
# PRIVACY_CONSENT_REQUIRED=true makes the server itself refuse a time-in
# from a student who has not agreed to the current privacy notice. The app
# asks either way; turn this on once everyone is using the current app.
# PRIVACY_CONSENT_REQUIRED=
# PHOTO_RETENTION_DAYS is how long a time-in photo is kept (whole days, at
# least 30). It only takes effect when `npm run privacy:purge-photos` is
# run; nothing is removed automatically.
# PHOTO_RETENTION_DAYS=

# Folder for uploaded files when Azure is not configured. On a host, point
# this at a persistent volume (for example /data/private-uploads) or the
# files are lost on every redeploy. Defaults to ./private-uploads.
# PRIVATE_UPLOAD_DIR=

# Email: password recovery, task deadline reminders and the summary emails.
# Two ways to send, tried in this order; with neither set, no email is sent
# and those features say so, as before.
#
# 1. An email provider's HTTPS API. This is the one that works on Railway,
#    which closes the SMTP ports on its smaller plans. EMAIL_PROVIDER names
#    the provider ("resend" is the one built in); EMAIL_API_KEY is its key
#    (a secret); SMTP_FROM below is the sender and must be an address on a
#    domain verified with the provider.
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
#
# The most emails to send in a day (the day in UTC). A free plan refuses
# anything over its daily number; with this set, the server stops by itself
# first and keeps the last fifth of the day's emails for password resets,
# so reminders cannot use them all. Unset (or under 10): no limit, nothing
# counted. Set it to your plan's daily number.
# EMAIL_DAILY_LIMIT=
#
# 2. SMTP: all five of the settings below.
# Keep credentials in backend/.env or your deployment secret store.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# When the supervisors' daily summary email goes out, as HH:MM in
# Philippine time (default 07:30). It needs the email settings above; without
# them no summary is sent.
# SUPERVISOR_DIGEST_TIME=07:30
# The coordinators' weekly summary of alerts: the day (SUN, MON, TUE, WED,
# THU, FRI or SAT; default MON) and the time (HH:MM, default 07:30). Also
# needs the email settings.
# COORDINATOR_DIGEST_DAY=MON
# COORDINATOR_DIGEST_TIME=07:30

# Durable private file storage. Leave unset for local development only;
# local private files are not durable on ephemeral hosting. Two choices;
# set only one of them.
#
# 1. A bucket on an S3-compatible object store. Written for Cloudflare R2.
#    All four, or none: with only some set the server refuses to start and
#    says which are missing. The two keys are secrets.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
#    Only for another S3-compatible store, or a local stand-in: the address
#    to use instead of the one worked out from the account.
# R2_ENDPOINT=
#
# 2. Azure Blob Storage.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=internet-private-files

# Standard Web Push VAPID keys. Keep the private key secret.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com
