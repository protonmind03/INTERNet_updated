# Copy this file to .env and fill in real values.
# Variable names are case-sensitive — they must match exactly what
# src/server.ts reads (process.env.DATABASE_PUBLIC_URL, process.env.PORT,
# process.env.JWT_SECRET).

DATABASE_PUBLIC_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/internet_ojt
PORT=5000

# Signs every login token. Must be at least 32 random characters; the
# server refuses to start while this placeholder is still in place.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Set to "production" on the hosting platform. It hides raw database errors
# from users, disables /api/test-db, restricts CORS to FRONTEND_URL, and
# trusts the platform's reverse proxy for rate limiting.
# NODE_ENV=production

# Public application URL used for password recovery links and, in
# production, the only browser origin allowed to call the API.
# Production URLs must use HTTPS.
FRONTEND_URL=http://localhost:5173

# Optional extra allowed browser origins in production, comma-separated
# (for example a custom domain in addition to the Vercel URL).
# CORS_ORIGINS=

# The server always runs on Philippine time (Asia/Manila). It sets this
# itself at start-up, so a TZ value here or on the host has no effect.

# Failed logins allowed per account before a 15-minute lockout (default 5).
# LOGIN_MAX_FAILURES=5

# Failed logins allowed from one network address, across all accounts, per
# 15 minutes (default 100). Keep it high if many users share one campus
# connection.
# LOGIN_IP_MAX_FAILURES=100

# How old a break, back-to-work or time-out recorded offline may be when the
# phone sends it, in hours (1 to 72, default 12). Older ones are refused and
# the student is pointed to the missed time-out form.
# OFFLINE_ACTION_MAX_AGE_HOURS=12

# Folder for uploaded files when Azure is not configured. On a host, point
# this at a persistent volume (for example /data/private-uploads) or the
# files are lost on every redeploy. Defaults to ./private-uploads.
# PRIVATE_UPLOAD_DIR=

# SMTP settings for password recovery and task deadline reminder emails.
# Keep credentials in backend/.env or your deployment secret store.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Durable private file storage. Leave unset for local development only;
# local private files are not durable on ephemeral hosting.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=internet-private-files

# Standard Web Push VAPID keys. Keep the private key secret.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com
