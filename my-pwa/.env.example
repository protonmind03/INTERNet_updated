# Copy this file to .env.local for local development.
# On Vercel, set this in Project Settings > Environment Variables instead.
# It is read at build time, so redeploy after changing it.

# Base URL of the backend API, with no trailing slash. 5000 is the backend's
# default port; if backend/.env sets another PORT, use the same one here.
VITE_API_URL=http://localhost:5000
